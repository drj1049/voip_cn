# Things git should not track: Mac junk, Python caches, installed packages,
# build output and virtual environments
.DS_Store
__pycache__/
.pytest_cache/
node_modules/
frontend/dist/
venv/
.venv/

# Recorded calls can hold private network traffic and be large, so they stay on this computer.
# The made-up example file is the only capture that is tracked.
captures/*.pcap
captures/*.pcapng
captures/*.cap
!captures/SYNTHETIC_*
